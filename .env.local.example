# Environment variables for local CLI testing
# Uncomment ONE cloud section, not both
#
# The CLI auto-detects cloud based on which variables are set:
#   - GCP_PROJECT present → gcp
#   - AZURE_SUBSCRIPTION_ID present → azure
#
# Or explicitly set: DEPLOY_CLOUD=gcp or DEPLOY_CLOUD=azure

# =============================================================================
# AZURE Container Apps
# =============================================================================
# Required (from infrastructure stack outputs)
#AZURE_CLIENT_ID=72d9cd7f-4242-4c02-8651-fd54bc99d93a
#AZURE_TENANT_ID=42215791-84e7-4a94-b3a7-f77cd4c79fac
#AZURE_SUBSCRIPTION_ID=1701a012-37d6-4f88-b086-f98bbdf258f0
#AZURE_RESOURCE_GROUP=trabian_west_sbx
#STATE_STORAGE_ACCOUNT=pulumistatebdf258f0
#AZURE_LOCATION=westus2

# =============================================================================
# GCP Cloud Run
# =============================================================================
# Required (from infrastructure stack outputs)
#GCP_PROJECT=your-project-id
#GCP_PROJECT_NUMBER=123456789
#GCP_REGION=us-central1
#STATE_BUCKET=your-state-bucket
#SERVICE_ACCOUNT_EMAIL=deploy@your-project.iam.gserviceaccount.com
#WIF_POOL_ID=cicd-deployments
#WIF_PROVIDER_ID=bitbucket

# =============================================================================
# Common (required for both clouds)
# =============================================================================
#PULUMI_CONFIG_PASSPHRASE=your-passphrase-here

# OIDC token (automatically provided by CI with 'oidc: true')
# For local testing, use a fake value to bypass validation
#BITBUCKET_STEP_OIDC_TOKEN=fake-token-for-testing
