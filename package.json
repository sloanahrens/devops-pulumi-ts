{
  "name": "devops-pulumi-ts",
  "version": "1.0.0",
  "description": "Pulumi-based infrastructure for deploying containerized apps to GCP Cloud Run or Azure Container Apps",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "test": "pnpm -r run test",
    "test:cli": "pnpm --filter cli run test",
    "lint": "pnpm --filter cli run lint",
    "build": "pnpm --filter cli run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.3"
    }
  }
}
